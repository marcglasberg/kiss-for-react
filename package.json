{
  "name": "kiss-for-react",
  "version": "2.0.4",
  "description": "Kiss state management, launched May 2025. Visit kissforreact.org for detailed docs and plenty of examples.",
  "exports": {
    ".": {
      "react-server": {
        "import": {
          "types": "./lib/esm/types/server.d.ts",
          "default": "./lib/esm/server.mjs"
        },
        "require": {
          "types": "./lib/cjs/types/server.d.ts",
          "default": "./lib/cjs/server.js"
        }
      },
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./lib/esm/types/server.d.ts",
        "default": "./lib/esm/server.mjs"
      },
      "require": {
        "types": "./lib/cjs/types/server.d.ts",
        "default": "./lib/cjs/server.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/cjs/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p ./tsconfig.esm.json && node scripts/fix-esm.cjs",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "test": "jest",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcglasberg/kiss-for-react.git"
  },
  "keywords": [
    "react",
    "reactjs",
    "state management",
    "state",
    "management",
    "hooks",
    "redux",
    "react query",
    "tanstack",
    "mobx",
    "zustand"
  ],
  "author": "Marcelo Glasberg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marcglasberg/kiss-for-react/issues"
  },
  "homepage": "https://github.com/marcglasberg/kiss-for-react#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "easy-bdd-tool-jest": "^1.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1 || ^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
