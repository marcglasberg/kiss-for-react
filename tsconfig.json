{
  // The config of the IDE and of Jest (ts-jest). The builds use `tsconfig.esm.json` and
  // `tsconfig.cjs.json`. All of them extend `tsconfig.base.json`, which has the source files and `rootDir`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "outDir": "./lib/esm",
    "declarationDir": "./lib/esm/types"
  }
}
